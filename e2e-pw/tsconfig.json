{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "rootDir": ".",
    "types": ["node"]
  },
  "include": [
    "playwright.config.ts",
    "fixtures/**/*.ts",
    "pages/**/*.ts",
    "api/**/*.ts",
    "tests/**/*.ts",
    "utils/**/*.ts",
    "constants/**/*.ts",
    "config/**/*.ts",
    "types/**/*.ts",
    "setup.ts"
  ],
  "exclude": ["node_modules", "test-results", "reports", "allure-results"]
}
